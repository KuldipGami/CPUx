<Application x:Class="CPUx.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- [0] is the palette; ThemeManager swaps it at runtime. -->
                <ResourceDictionary Source="Themes/Dark.xaml" />
                <ResourceDictionary Source="Themes/Templates.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Color x:Key="Color.Accent">#4C8DFF</Color>
            <SolidColorBrush x:Key="Accent" Color="#4C8DFF" />
            <SolidColorBrush x:Key="Accent.Soft" Color="#334C8DFF" />
            <SolidColorBrush x:Key="Accent.Fg" Color="White" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
