<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="Color.Base">#EEF1F6</Color>
    <Color x:Key="Color.Cpu">#2563EB</Color>
    <Color x:Key="Color.Gpu">#16A34A</Color>
    <Color x:Key="Color.Mem">#7C3AED</Color>
    <Color x:Key="Color.Disk">#0891B2</Color>
    <Color x:Key="Color.Net">#D97706</Color>
    <Color x:Key="Color.Temp">#E11D48</Color>
    <Color x:Key="Color.Power">#EA580C</Color>
    <Color x:Key="Color.Battery">#65A30D</Color>

    <!-- Surfaces -->
    <SolidColorBrush x:Key="Bg.Base" Color="#EEF1F6" />
    <SolidColorBrush x:Key="Bg.Layer" Color="#F6F8FB" />
    <SolidColorBrush x:Key="Bg.Card" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Bg.CardHover" Color="#FAFBFD" />
    <SolidColorBrush x:Key="Bg.Subtle" Color="#0A0F172A" />
    <SolidColorBrush x:Key="Bg.SubtleHover" Color="#120F172A" />
    <SolidColorBrush x:Key="Bg.SubtlePressed" Color="#070F172A" />
    <SolidColorBrush x:Key="Bg.Input" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Bg.Popup" Color="#FFFFFF" />

    <!-- Strokes -->
    <SolidColorBrush x:Key="Stroke.Card" Color="#E2E6EE" />
    <SolidColorBrush x:Key="Stroke.Divider" Color="#EDF0F5" />
    <SolidColorBrush x:Key="Stroke.Control" Color="#D5DBE5" />

    <!-- Text -->
    <SolidColorBrush x:Key="Text.Primary" Color="#111827" />
    <SolidColorBrush x:Key="Text.Secondary" Color="#545E6E" />
    <SolidColorBrush x:Key="Text.Tertiary" Color="#8A93A3" />

    <!-- Charts / meters -->
    <SolidColorBrush x:Key="Chart.Grid" Color="#120F172A" />
    <SolidColorBrush x:Key="Track" Color="#140F172A" />
    <SolidColorBrush x:Key="Scroll.Thumb" Color="#330F172A" />
    <SolidColorBrush x:Key="Scroll.ThumbHover" Color="#550F172A" />

    <!-- Category colors -->
    <SolidColorBrush x:Key="Brush.Cpu" Color="{StaticResource Color.Cpu}" />
    <SolidColorBrush x:Key="Brush.Gpu" Color="{StaticResource Color.Gpu}" />
    <SolidColorBrush x:Key="Brush.Mem" Color="{StaticResource Color.Mem}" />
    <SolidColorBrush x:Key="Brush.Disk" Color="{StaticResource Color.Disk}" />
    <SolidColorBrush x:Key="Brush.Net" Color="{StaticResource Color.Net}" />
    <SolidColorBrush x:Key="Brush.Temp" Color="{StaticResource Color.Temp}" />
    <SolidColorBrush x:Key="Brush.Power" Color="{StaticResource Color.Power}" />
    <SolidColorBrush x:Key="Brush.Battery" Color="{StaticResource Color.Battery}" />

    <SolidColorBrush x:Key="Soft.Cpu" Color="#1A2563EB" />
    <SolidColorBrush x:Key="Soft.Gpu" Color="#1A16A34A" />
    <SolidColorBrush x:Key="Soft.Mem" Color="#1A7C3AED" />
    <SolidColorBrush x:Key="Soft.Disk" Color="#1A0891B2" />
    <SolidColorBrush x:Key="Soft.Net" Color="#1AD97706" />
    <SolidColorBrush x:Key="Soft.Temp" Color="#1AE11D48" />
    <SolidColorBrush x:Key="Soft.Power" Color="#1AEA580C" />
    <SolidColorBrush x:Key="Soft.Battery" Color="#1A65A30D" />

    <!-- Status -->
    <SolidColorBrush x:Key="Good" Color="#16A34A" />
    <SolidColorBrush x:Key="Warn" Color="#D97706" />
    <SolidColorBrush x:Key="Bad" Color="#DC2626" />
    <SolidColorBrush x:Key="Soft.Good" Color="#1A16A34A" />
    <SolidColorBrush x:Key="Soft.Warn" Color="#1AD97706" />
    <SolidColorBrush x:Key="Soft.Bad" Color="#1ADC2626" />

    <!-- Memory composition -->
    <SolidColorBrush x:Key="Mem.InUse" Color="#7C3AED" />
    <SolidColorBrush x:Key="Mem.Modified" Color="#D97706" />
    <SolidColorBrush x:Key="Mem.Standby" Color="#3B82F6" />
    <SolidColorBrush x:Key="Mem.Free" Color="#DCE1EA" />

</ResourceDictionary>
