<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:CPUx.Controls"
                    xmlns:core="clr-namespace:CPUx.Core"
                    xmlns:vm="clr-namespace:CPUx.ViewModels">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Styles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <core:BoolToVisibilityConverter x:Key="BoolToVis" />
    <core:InverseBoolConverter x:Key="Not" />
    <core:HasValueToVisibilityConverter x:Key="HasValue" />
    <core:EqualsConverter x:Key="Equals" />
    <core:IconKeyConverter x:Key="IconKey" />
    <core:HexToBrushConverter x:Key="HexBrush" />
    <core:LevelToBrushConverter x:Key="LevelBrush" />

    <Style TargetType="c:LiveChart">
        <Setter Property="GridBrush" Value="{DynamicResource Chart.Grid}" />
        <Setter Property="LabelBrush" Value="{DynamicResource Text.Tertiary}" />
    </Style>

    <Style TargetType="c:RingGauge">
        <Setter Property="TrackBrush" Value="{DynamicResource Track}" />
    </Style>

    <!-- Info card: title + label/value rows. DataContext = InfoSection -->
    <DataTemplate x:Key="SectionCard" DataType="{x:Type core:InfoSection}">
        <Border Style="{StaticResource Card}" Padding="18,14,18,10">
            <StackPanel>
                <DockPanel Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="26" Height="26" Margin="0,-4,-6,0"
                            Command="{Binding CopyCommand}" ToolTip="Copy section">
                        <c:Icon Data="{StaticResource I.Copy}" Width="14" Height="14" />
                    </Button>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource T.CardTitle}" VerticalAlignment="Center" />
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type core:InfoItem}">
                            <Border BorderBrush="{DynamicResource Stroke.Divider}" BorderThickness="0,1,0,0" Padding="0,7" Background="Transparent">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Copy value" Command="{Binding CopyValueCommand}" />
                                        <MenuItem Header="Copy row" Command="{Binding CopyRowCommand}" />
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0.42*" />
                                        <ColumnDefinition Width="0.58*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource T.Label}" FontSize="12.5" Margin="0,0,12,0"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource T.Value}" TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- Masonry list of info cards -->
    <Style x:Key="SectionList" TargetType="ItemsControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ItemTemplate" Value="{StaticResource SectionCard}" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <c:MasonryPanel MinColumnWidth="400" Spacing="16" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Large statistic: label over value. DataContext = Stat -->
    <DataTemplate x:Key="StatTemplate" DataType="{x:Type vm:Stat}">
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="{Binding Label}" Style="{StaticResource T.Label}" />
            <TextBlock Text="{Binding Value}" Style="{StaticResource T.Stat}" Margin="0,2,0,0" ToolTip="{Binding Value}" />
        </StackPanel>
    </DataTemplate>

    <Style x:Key="StatGrid" TargetType="ItemsControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ItemTemplate" Value="{StaticResource StatTemplate}" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <c:MasonryPanel MinColumnWidth="150" Spacing="12" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Volume usage row. DataContext = VolumeVM -->
    <DataTemplate x:Key="VolumeTemplate" DataType="{x:Type vm:VolumeVM}">
        <Grid Margin="0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="38" Height="38" CornerRadius="9" Background="{DynamicResource Soft.Disk}" Margin="0,0,12,0">
                <TextBlock Text="{Binding Letter}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Disk}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding UsedPercent, StringFormat={}{0:0}%}" Style="{StaticResource T.Label}" />
                    <TextBlock Text="{Binding Label}" Style="{StaticResource T.Value}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <ProgressBar Style="{StaticResource Bar}" Value="{Binding UsedPercent, Mode=OneWay}" Margin="0,6,0,5"
                             Foreground="{Binding UsedPercent, Converter={StaticResource LevelBrush}, ConverterParameter=Brush.Disk}" />
                <TextBlock Text="{Binding Detail}" Style="{StaticResource T.Caption}" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- Page scroll host -->
    <Style x:Key="PageScroll" TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Padding" Value="28,4,22,28" />
    </Style>

    <!-- Loading placeholder -->
    <DataTemplate x:Key="LoadingTemplate">
        <StackPanel HorizontalAlignment="Center" Margin="0,60">
            <TextBlock Text="Reading hardware…" Style="{StaticResource T.Subtitle}" HorizontalAlignment="Center" />
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
