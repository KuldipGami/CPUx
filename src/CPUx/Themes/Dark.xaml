<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="Color.Base">#0D1017</Color>
    <Color x:Key="Color.Cpu">#4C9AFF</Color>
    <Color x:Key="Color.Gpu">#3DDC84</Color>
    <Color x:Key="Color.Mem">#A78BFA</Color>
    <Color x:Key="Color.Disk">#22D3EE</Color>
    <Color x:Key="Color.Net">#FBBF24</Color>
    <Color x:Key="Color.Temp">#FB7185</Color>
    <Color x:Key="Color.Power">#FB923C</Color>
    <Color x:Key="Color.Battery">#A3E635</Color>

    <!-- Surfaces -->
    <SolidColorBrush x:Key="Bg.Base" Color="#0D1017" />
    <SolidColorBrush x:Key="Bg.Layer" Color="#11151C" />
    <SolidColorBrush x:Key="Bg.Card" Color="#171C25" />
    <SolidColorBrush x:Key="Bg.CardHover" Color="#1C222D" />
    <SolidColorBrush x:Key="Bg.Subtle" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="Bg.SubtleHover" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="Bg.SubtlePressed" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="Bg.Input" Color="#0E1218" />
    <SolidColorBrush x:Key="Bg.Popup" Color="#1B212C" />

    <!-- Strokes -->
    <SolidColorBrush x:Key="Stroke.Card" Color="#222936" />
    <SolidColorBrush x:Key="Stroke.Divider" Color="#1E2430" />
    <SolidColorBrush x:Key="Stroke.Control" Color="#2C3442" />

    <!-- Text -->
    <SolidColorBrush x:Key="Text.Primary" Color="#ECEFF4" />
    <SolidColorBrush x:Key="Text.Secondary" Color="#98A1B0" />
    <SolidColorBrush x:Key="Text.Tertiary" Color="#646D7E" />

    <!-- Charts / meters -->
    <SolidColorBrush x:Key="Chart.Grid" Color="#10FFFFFF" />
    <SolidColorBrush x:Key="Track" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="Scroll.Thumb" Color="#30FFFFFF" />
    <SolidColorBrush x:Key="Scroll.ThumbHover" Color="#55FFFFFF" />

    <!-- Category colors -->
    <SolidColorBrush x:Key="Brush.Cpu" Color="{StaticResource Color.Cpu}" />
    <SolidColorBrush x:Key="Brush.Gpu" Color="{StaticResource Color.Gpu}" />
    <SolidColorBrush x:Key="Brush.Mem" Color="{StaticResource Color.Mem}" />
    <SolidColorBrush x:Key="Brush.Disk" Color="{StaticResource Color.Disk}" />
    <SolidColorBrush x:Key="Brush.Net" Color="{StaticResource Color.Net}" />
    <SolidColorBrush x:Key="Brush.Temp" Color="{StaticResource Color.Temp}" />
    <SolidColorBrush x:Key="Brush.Power" Color="{StaticResource Color.Power}" />
    <SolidColorBrush x:Key="Brush.Battery" Color="{StaticResource Color.Battery}" />

    <SolidColorBrush x:Key="Soft.Cpu" Color="#264C9AFF" />
    <SolidColorBrush x:Key="Soft.Gpu" Color="#263DDC84" />
    <SolidColorBrush x:Key="Soft.Mem" Color="#26A78BFA" />
    <SolidColorBrush x:Key="Soft.Disk" Color="#2622D3EE" />
    <SolidColorBrush x:Key="Soft.Net" Color="#26FBBF24" />
    <SolidColorBrush x:Key="Soft.Temp" Color="#26FB7185" />
    <SolidColorBrush x:Key="Soft.Power" Color="#26FB923C" />
    <SolidColorBrush x:Key="Soft.Battery" Color="#26A3E635" />

    <!-- Status -->
    <SolidColorBrush x:Key="Good" Color="#4ADE80" />
    <SolidColorBrush x:Key="Warn" Color="#FBBF24" />
    <SolidColorBrush x:Key="Bad" Color="#F87171" />
    <SolidColorBrush x:Key="Soft.Good" Color="#224ADE80" />
    <SolidColorBrush x:Key="Soft.Warn" Color="#22FBBF24" />
    <SolidColorBrush x:Key="Soft.Bad" Color="#22F87171" />

    <!-- Memory composition -->
    <SolidColorBrush x:Key="Mem.InUse" Color="#A78BFA" />
    <SolidColorBrush x:Key="Mem.Modified" Color="#F59E0B" />
    <SolidColorBrush x:Key="Mem.Standby" Color="#4C9AFF" />
    <SolidColorBrush x:Key="Mem.Free" Color="#2A3240" />

</ResourceDictionary>
