<UserControl x:Class="CPUx.Views.SensorsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CPUx.Controls"
             xmlns:vm="clr-namespace:CPUx.ViewModels">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="28,0,28,12">
            <Border Style="{StaticResource Card}" Background="{DynamicResource Soft.Warn}" BorderBrush="Transparent" Padding="14,12" Margin="0,0,0,12"
                    Visibility="{Binding ShowBanner, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <c:Icon Data="{StaticResource I.Warning}" Width="18" Height="18" Foreground="{DynamicResource Warn}" VerticalAlignment="Top" Margin="0,1,12,0" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Button Style="{StaticResource Btn}" Content="Restart as admin" Margin="0,0,8,0"
                                Command="{Binding DataContext.RestartAsAdminCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                Visibility="{Binding DataContext.CanElevate, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                        <Button Style="{StaticResource Btn}" Content="Get PawnIO"
                                Command="{Binding DataContext.Settings.OpenPawnIoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                Visibility="{Binding PawnIo, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                    </StackPanel>
                    <TextBlock Text="{Binding BannerText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="Hide empty" Style="{StaticResource T.Label}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding HideEmpty}" Margin="0,0,8,0" ToolTip="Hide sensors that have not reported a value" />
                    <Button Style="{StaticResource Btn}" Command="{Binding ExpandAllCommand}" CommandParameter="true" Content="Expand all" Margin="8,0,0,0" />
                    <Button Style="{StaticResource Btn}" Command="{Binding ExpandAllCommand}" CommandParameter="false" Content="Collapse all" Margin="8,0,0,0" />
                    <Button Style="{StaticResource Btn}" Command="{Binding ResetMinMaxCommand}" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Data="{StaticResource I.Refresh}" Width="14" Height="14" />
                            <TextBlock Text="Reset min/max" Margin="7,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBox Style="{StaticResource SearchBox}" Tag="Filter sensors (e.g. temperature, fan, core)" MaxWidth="420" HorizontalAlignment="Left"
                         Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
        </StackPanel>

        <ScrollViewer Style="{StaticResource PageScroll}" Padding="28,0,22,28">
            <StackPanel>
                <TextBlock Text="Starting sensor library…" Style="{StaticResource T.Subtitle}" Margin="0,40" HorizontalAlignment="Center"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
                <ItemsControl ItemsSource="{Binding Hardware}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <c:MasonryPanel MinColumnWidth="460" Spacing="16" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVis}}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SensorHardware}">
                            <Expander Style="{StaticResource GroupExpander}" IsExpanded="{Binding IsExpanded}">
                                <Expander.Header>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource T.Caption}" VerticalAlignment="Center">
                                            <Run Text="{Binding Count, Mode=OneWay}" /><Run Text=" sensors" />
                                        </TextBlock>
                                        <Border Style="{StaticResource IconTile}" Width="30" Height="30" Background="{DynamicResource Accent.Soft}">
                                            <c:Icon Data="{Binding Icon, Converter={StaticResource IconKey}}" Width="16" Height="16" Foreground="{DynamicResource Accent}" />
                                        </Border>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource T.CardTitle}" Margin="10,0,10,0" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Expander.Header>
                                <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVis}}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:SensorGroup}">
                                            <StackPanel Margin="0,6,0,4">
                                                <Grid Margin="0,4,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="92" />
                                                        <ColumnDefinition Width="92" />
                                                        <ColumnDefinition Width="92" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Accent}" />
                                                    <TextBlock Grid.Column="1" Text="Value" Style="{StaticResource T.Caption}" HorizontalAlignment="Right" />
                                                    <TextBlock Grid.Column="2" Text="Min" Style="{StaticResource T.Caption}" HorizontalAlignment="Right" />
                                                    <TextBlock Grid.Column="3" Text="Max" Style="{StaticResource T.Caption}" HorizontalAlignment="Right" />
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                                                    <ItemsControl.ItemContainerStyle>
                                                        <Style TargetType="ContentPresenter">
                                                            <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVis}}" />
                                                        </Style>
                                                    </ItemsControl.ItemContainerStyle>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:SensorRow}">
                                                            <Border BorderBrush="{DynamicResource Stroke.Divider}" BorderThickness="0,1,0,0" Padding="0,6">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="92" />
                                                                        <ColumnDefinition Width="92" />
                                                                        <ColumnDefinition Width="92" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource T.Label}" FontSize="12.5" ToolTip="{Binding Id}" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                                    <TextBlock Grid.Column="2" Text="{Binding Min}" Style="{StaticResource T.Label}" HorizontalAlignment="Right" />
                                                                    <TextBlock Grid.Column="3" Text="{Binding Max}" Style="{StaticResource T.Label}" HorizontalAlignment="Right" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
