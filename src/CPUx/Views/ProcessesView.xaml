<UserControl x:Class="CPUx.Views.ProcessesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CPUx.Controls"
             xmlns:vm="clr-namespace:CPUx.ViewModels">
    <UserControl.Resources>
        <Style x:Key="RightText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="RightHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource GridHeader}">
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>
    </UserControl.Resources>
    <DockPanel Margin="28,0,28,24">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource Btn}" Command="{Binding OpenLocationCommand}" Margin="8,0,0,0" ToolTip="Open file location">
                    <StackPanel Orientation="Horizontal">
                        <c:Icon Data="{StaticResource I.Folder}" Width="14" Height="14" />
                        <TextBlock Text="Location" Margin="7,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Btn.Danger}" Command="{Binding EndTaskCommand}" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <c:Icon Data="{StaticResource I.EndTask}" Width="14" Height="14" />
                        <TextBlock Text="End task" Margin="7,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBox Style="{StaticResource SearchBox}" Tag="Search by name, description or PID" MaxWidth="380" HorizontalAlignment="Left"
                     Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" Style="{StaticResource T.Caption}" Margin="2,0,0,8" />

        <Border Style="{StaticResource Card}" Padding="6,4">
            <DataGrid x:Name="Grid" Style="{StaticResource Grid}" ItemsSource="{Binding View}" SelectedItem="{Binding Selected}"
                      CanUserSortColumns="True">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="End task" Command="{Binding EndTaskCommand}" />
                        <MenuItem Header="Open file location" Command="{Binding OpenLocationCommand}" />
                        <MenuItem Header="Copy details" Command="{Binding CopyDetailsCommand}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Name" Width="*" MinWidth="220" SortMemberPath="Description" CanUserSort="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:ProcessItem}">
                                <StackPanel Orientation="Horizontal" ToolTip="{Binding Path}">
                                    <Grid Width="16" Height="16" Margin="0,0,10,0">
                                        <Border CornerRadius="4" Background="{DynamicResource Bg.SubtleHover}" />
                                        <Image Source="{Binding Icon}" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Grid>
                                    <TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource T.Caption}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="PID" Width="70" Binding="{Binding Pid}" SortMemberPath="Pid"
                                        ElementStyle="{StaticResource RightText}" HeaderStyle="{StaticResource RightHeader}" />
                    <DataGridTextColumn Header="CPU" Width="80" Binding="{Binding CpuText}" SortMemberPath="Cpu" SortDirection="Descending"
                                        ElementStyle="{StaticResource RightText}" HeaderStyle="{StaticResource RightHeader}" />
                    <DataGridTextColumn Header="Memory" Width="100" Binding="{Binding MemoryText}" SortMemberPath="Memory"
                                        ElementStyle="{StaticResource RightText}" HeaderStyle="{StaticResource RightHeader}" />
                    <DataGridTextColumn Header="Commit" Width="100" Binding="{Binding CommitText}" SortMemberPath="Commit"
                                        ElementStyle="{StaticResource RightText}" HeaderStyle="{StaticResource RightHeader}" />
                    <DataGridTextColumn Header="Disk I/O" Width="100" Binding="{Binding DiskText}" SortMemberPath="Disk"
                                        ElementStyle="{StaticResource RightText}" HeaderStyle="{StaticResource RightHeader}" />
                    <DataGridTextColumn Header="GPU" Width="70" Binding="{Binding GpuText}" SortMemberPath="Gpu"
                                        ElementStyle="{StaticResource RightText}" HeaderStyle="{StaticResource RightHeader}" />
                    <DataGridTextColumn Header="Threads" Width="80" Binding="{Binding Threads}" SortMemberPath="Threads"
                                        ElementStyle="{StaticResource RightText}" HeaderStyle="{StaticResource RightHeader}" />
                    <DataGridTextColumn Header="Handles" Width="80" Binding="{Binding Handles}" SortMemberPath="Handles"
                                        ElementStyle="{StaticResource RightText}" HeaderStyle="{StaticResource RightHeader}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
