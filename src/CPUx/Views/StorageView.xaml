<UserControl x:Class="CPUx.Views.StorageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CPUx.Controls"
             xmlns:vm="clr-namespace:CPUx.ViewModels">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel>
            <TextBlock Text="Reading drives…" Style="{StaticResource T.Subtitle}" Margin="0,40" HorizontalAlignment="Center"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
            <ItemsControl ItemsSource="{Binding Disks}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DiskItem}">
                        <StackPanel Margin="0,0,0,28">
                            <!-- Drive header card -->
                            <Border Style="{StaticResource Card}" Padding="20">
                                <StackPanel>
                                    <DockPanel>
                                        <Border Style="{StaticResource IconTile}" Width="44" Height="44" CornerRadius="11" Background="{DynamicResource Soft.Disk}">
                                            <c:Icon Data="{StaticResource I.Storage}" Width="22" Height="22" Foreground="{DynamicResource Brush.Disk}" />
                                        </Border>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border x:Name="HealthChip" Style="{StaticResource Chip}" Background="{DynamicResource Soft.Good}">
                                                <StackPanel Orientation="Horizontal">
                                                    <c:Icon x:Name="HealthIcon" Data="{StaticResource I.Check}" Width="12" Height="12" StrokeThickness="2.6"
                                                            Foreground="{DynamicResource Good}" Margin="0,0,5,0" />
                                                    <TextBlock x:Name="HealthText" Text="{Binding Health}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Good}" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontFamily="{StaticResource Font.Display}" FontSize="18" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <Border Style="{StaticResource Chip}" Background="{DynamicResource Soft.Disk}" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding Media}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Disk}" />
                                                </Border>
                                                <Border Style="{StaticResource Chip}" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding Bus}" FontSize="11" Foreground="{DynamicResource Text.Secondary}" />
                                                </Border>
                                                <Border Style="{StaticResource Chip}" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding Size}" FontSize="11" Foreground="{DynamicResource Text.Secondary}" />
                                                </Border>
                                                <Border Style="{StaticResource Chip}" Visibility="{Binding IsSystem, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="System" FontSize="11" Foreground="{DynamicResource Text.Secondary}" />
                                                </Border>
                                                <TextBlock Text="{Binding Header}" Style="{StaticResource T.Caption}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DockPanel>

                                    <Grid Margin="0,18,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="0.9*" MinWidth="200" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,8">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding ActiveText}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Disk}" />
                                                <TextBlock Text="Active time" Style="{StaticResource T.Label}" />
                                            </DockPanel>
                                            <Border BorderBrush="{DynamicResource Stroke.Divider}" BorderThickness="1" CornerRadius="8" Height="120">
                                                <c:LiveChart Series="{Binding ActiveSeries}" Stroke="{DynamicResource Brush.Disk}" Maximum="100" ScaleUnit="%" CornerRadius="8" />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <DockPanel Margin="0,0,0,8">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                    <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Disk}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding ReadText}" FontSize="12" Margin="0,0,10,0" />
                                                    <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Net}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding WriteText}" FontSize="12" />
                                                </StackPanel>
                                                <TextBlock Text="Transfer rate" Style="{StaticResource T.Label}" />
                                            </DockPanel>
                                            <Border BorderBrush="{DynamicResource Stroke.Divider}" BorderThickness="1" CornerRadius="8" Height="120">
                                                <c:LiveChart Series="{Binding ReadSeries}" Series2="{Binding WriteSeries}" Stroke="{DynamicResource Brush.Disk}"
                                                             Stroke2="{DynamicResource Brush.Net}" Maximum="0" MinimumScale="102400" ScaleUnit="B/s" CornerRadius="8" />
                                            </Border>
                                        </StackPanel>
                                        <ItemsControl Grid.Column="4" ItemsSource="{Binding Stats}" Style="{StaticResource StatGrid}" Margin="4,0,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <c:MasonryPanel MinColumnWidth="110" Spacing="10" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding Volumes}" ItemTemplate="{StaticResource VolumeTemplate}" Focusable="False" Margin="0,12,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <c:MasonryPanel MinColumnWidth="260" Spacing="20" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <ItemsControl ItemsSource="{Binding Sections}" Style="{StaticResource SectionList}" Margin="0,16,0,0" />
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsHealthy}" Value="False">
                                <Setter TargetName="HealthChip" Property="Background" Value="{DynamicResource Soft.Warn}" />
                                <Setter TargetName="HealthText" Property="Foreground" Value="{DynamicResource Warn}" />
                                <Setter TargetName="HealthIcon" Property="Foreground" Value="{DynamicResource Warn}" />
                                <Setter TargetName="HealthIcon" Property="Data" Value="{StaticResource I.Warning}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
