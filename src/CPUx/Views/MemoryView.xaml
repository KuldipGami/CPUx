<UserControl x:Class="CPUx.Views.MemoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CPUx.Controls">
    <UserControl.Resources>
        <Style x:Key="LegendDot" TargetType="Border">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel>
            <!-- Hero -->
            <Border Style="{StaticResource Card}" Padding="22">
                <DockPanel>
                    <Grid DockPanel.Dock="Right" Width="150" Height="150" Margin="24,0,0,0">
                        <c:RingGauge Value="{Binding LoadPercent}" Stroke="{DynamicResource Brush.Mem}" Thickness="12" />
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding LoadText}" Style="{StaticResource T.Big}" HorizontalAlignment="Center" />
                            <TextBlock Text="in use" Style="{StaticResource T.Label}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource Chip}" Background="{DynamicResource Soft.Mem}">
                                <TextBlock Text="RAM" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource Brush.Mem}" />
                            </Border>
                        </StackPanel>
                        <TextBlock FontFamily="{StaticResource Font.Display}" FontSize="22" FontWeight="SemiBold" Margin="0,10,0,2">
                            <Run Text="{Binding UsedText, Mode=OneWay}" /><Run Text=" of " Foreground="{DynamicResource Text.Secondary}" /><Run Text="{Binding TotalText, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="{Binding Summary}" Style="{StaticResource T.Label}" Margin="0,0,0,16" />

                        <c:StackedBar Height="14" Value1="{Binding InUse}" Value2="{Binding Modified}" Value3="{Binding Standby}" Value4="{Binding Free}"
                                      Brush1="{DynamicResource Mem.InUse}" Brush2="{DynamicResource Mem.Modified}"
                                      Brush3="{DynamicResource Mem.Standby}" Brush4="{DynamicResource Mem.Free}" />
                        <WrapPanel Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,22,4">
                                <Border Style="{StaticResource LegendDot}" Background="{DynamicResource Mem.InUse}" />
                                <TextBlock Text="In use " Style="{StaticResource T.Label}" />
                                <TextBlock Text="{Binding InUseText}" FontWeight="SemiBold" FontSize="12" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,22,4">
                                <Border Style="{StaticResource LegendDot}" Background="{DynamicResource Mem.Modified}" />
                                <TextBlock Text="Modified " Style="{StaticResource T.Label}" />
                                <TextBlock Text="{Binding ModifiedText}" FontWeight="SemiBold" FontSize="12" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,22,4">
                                <Border Style="{StaticResource LegendDot}" Background="{DynamicResource Mem.Standby}" />
                                <TextBlock Text="Standby " Style="{StaticResource T.Label}" />
                                <TextBlock Text="{Binding StandbyText}" FontWeight="SemiBold" FontSize="12" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,22,4">
                                <Border Style="{StaticResource LegendDot}" Background="{DynamicResource Mem.Free}" />
                                <TextBlock Text="Free " Style="{StaticResource T.Label}" />
                                <TextBlock Text="{Binding FreeText}" FontWeight="SemiBold" FontSize="12" />
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding LoadText}" Style="{StaticResource T.CardTitle}" Foreground="{DynamicResource Brush.Mem}" />
                            <TextBlock Text="Memory usage" Style="{StaticResource T.CardTitle}" />
                        </DockPanel>
                        <Border BorderBrush="{DynamicResource Stroke.Divider}" BorderThickness="1" CornerRadius="8" Height="200">
                            <c:LiveChart Series="{Binding UsageSeries}" Stroke="{DynamicResource Brush.Mem}" Maximum="100" ShowDot="True"
                                         ScaleUnit="%" StrokeThickness="2" CornerRadius="8" />
                        </Border>
                    </DockPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Commit charge" Style="{StaticResource T.CardTitle}" Margin="0,0,0,12" />
                        <Border BorderBrush="{DynamicResource Stroke.Divider}" BorderThickness="1" CornerRadius="8" Height="200">
                            <c:LiveChart Series="{Binding CommitSeries}" Stroke="{DynamicResource Brush.Net}" Maximum="100" ScaleUnit="%" CornerRadius="8" />
                        </Border>
                    </DockPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="18,16,18,4">
                <StackPanel>
                    <TextBlock Text="Live readings" Style="{StaticResource T.CardTitle}" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding Stats}" Style="{StaticResource StatGrid}" />
                </StackPanel>
            </Border>

            <TextBlock Text="Memory modules" Style="{StaticResource T.Section}" />
            <ItemsControl ItemsSource="{Binding Modules}" Style="{StaticResource SectionList}" />

            <TextBlock Text="Details" Style="{StaticResource T.Section}" />
            <ItemsControl ItemsSource="{Binding Sections}" Style="{StaticResource SectionList}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
