<UserControl x:Class="CPUx.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CPUx.Controls"
             xmlns:vm="clr-namespace:CPUx.ViewModels">
    <UserControl.Resources>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        </Style>
        <Style x:Key="RowDesc" TargetType="TextBlock" BasedOn="{StaticResource T.Label}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="None" />
            <Setter Property="Margin" Value="0,2,24,0" />
        </Style>
        <Style x:Key="Row" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,10" />
            <Setter Property="LastChildFill" Value="True" />
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource Stroke.Divider}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel MaxWidth="900" HorizontalAlignment="Left">

            <!-- Appearance -->
            <TextBlock Text="Appearance" Style="{StaticResource T.Section}" Margin="2,4,0,12" />
            <Border Style="{StaticResource Card}" Padding="20,8">
                <StackPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <Border DockPanel.Dock="Right" Style="{StaticResource SegmentHost}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" Content="Dark" IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter=Dark}" />
                                <RadioButton Style="{StaticResource Segment}" Content="Light" IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter=Light}" />
                                <RadioButton Style="{StaticResource Segment}" Content="System" IsChecked="{Binding Theme, Converter={StaticResource Equals}, ConverterParameter=System}" />
                            </StackPanel>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Theme" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Choose a dark or light look, or follow the Windows setting." Style="{StaticResource RowDesc}" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource Divider}" />
                    <DockPanel Style="{StaticResource Row}">
                        <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Accents}" Focusable="False" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:AccentOption}">
                                    <RadioButton Style="{StaticResource Swatch}" GroupName="Accent" ToolTip="{Binding Name}"
                                                 Background="{Binding Hex, Converter={StaticResource HexBrush}}"
                                                 IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                 Command="{Binding DataContext.SelectAccentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel>
                            <TextBlock Text="Accent color" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Used for highlights, selection and buttons." Style="{StaticResource RowDesc}" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource Divider}" />
                    <DockPanel Style="{StaticResource Row}">
                        <Border DockPanel.Dock="Right" Style="{StaticResource SegmentHost}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" Content="°C" IsChecked="{Binding S.Fahrenheit, Converter={StaticResource Equals}, ConverterParameter=False}" />
                                <RadioButton Style="{StaticResource Segment}" Content="°F" IsChecked="{Binding S.Fahrenheit, Converter={StaticResource Equals}, ConverterParameter=True}" />
                            </StackPanel>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Temperature unit" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Applies to every temperature shown in the app and in reports." Style="{StaticResource RowDesc}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Monitoring -->
            <TextBlock Text="Monitoring" Style="{StaticResource T.Section}" />
            <Border Style="{StaticResource Card}" Padding="20,8">
                <StackPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <Border DockPanel.Dock="Right" Style="{StaticResource SegmentHost}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" Content="0.5 s" IsChecked="{Binding Interval, Converter={StaticResource Equals}, ConverterParameter=500}" />
                                <RadioButton Style="{StaticResource Segment}" Content="1 s" IsChecked="{Binding Interval, Converter={StaticResource Equals}, ConverterParameter=1000}" />
                                <RadioButton Style="{StaticResource Segment}" Content="2 s" IsChecked="{Binding Interval, Converter={StaticResource Equals}, ConverterParameter=2000}" />
                                <RadioButton Style="{StaticResource Segment}" Content="5 s" IsChecked="{Binding Interval, Converter={StaticResource Equals}, ConverterParameter=5000}" />
                            </StackPanel>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Update interval" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="How often live readings refresh. Longer intervals use less CPU." Style="{StaticResource RowDesc}" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource Divider}" />
                    <DockPanel Style="{StaticResource Row}">
                        <Border DockPanel.Dock="Right" Style="{StaticResource SegmentHost}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" Content="30 s" IsChecked="{Binding History, Converter={StaticResource Equals}, ConverterParameter=30}" />
                                <RadioButton Style="{StaticResource Segment}" Content="1 min" IsChecked="{Binding History, Converter={StaticResource Equals}, ConverterParameter=60}" />
                                <RadioButton Style="{StaticResource Segment}" Content="2 min" IsChecked="{Binding History, Converter={StaticResource Equals}, ConverterParameter=120}" />
                                <RadioButton Style="{StaticResource Segment}" Content="5 min" IsChecked="{Binding History, Converter={StaticResource Equals}, ConverterParameter=300}" />
                            </StackPanel>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Graph history" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Time window shown by every chart." Style="{StaticResource RowDesc}" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource Divider}" />
                    <DockPanel Style="{StaticResource Row}">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding S.EnableSensors}" />
                        <StackPanel>
                            <TextBlock Text="Hardware sensors" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Temperatures, clocks, voltages, fans and power via LibreHardwareMonitor. Full CPU and motherboard data needs administrator rights and the PawnIO driver." Style="{StaticResource RowDesc}" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource Divider}" />
                    <DockPanel Style="{StaticResource Row}">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding S.PollNvidia}" />
                        <StackPanel>
                            <TextBlock Text="Detailed NVIDIA readings" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Temperature, power, clocks, fan and PCIe link from the NVIDIA driver. On laptops this can keep the discrete GPU awake and use more battery." Style="{StaticResource RowDesc}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Alerts -->
            <TextBlock Text="Alerts" Style="{StaticResource T.Section}" />
            <Border Style="{StaticResource Card}" Padding="20,8">
                <StackPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding S.TempAlerts}" />
                        <StackPanel>
                            <TextBlock Text="High temperature notifications" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Show a notification when the CPU or GPU gets hotter than the threshold (at most every 5 minutes)." Style="{StaticResource RowDesc}" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource Divider}" />
                    <DockPanel Style="{StaticResource Row}" IsEnabled="{Binding S.TempAlerts}">
                        <Border DockPanel.Dock="Right" Style="{StaticResource SegmentHost}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" Content="80 °C" IsChecked="{Binding S.AlertThreshold, Converter={StaticResource Equals}, ConverterParameter=80}" />
                                <RadioButton Style="{StaticResource Segment}" Content="85 °C" IsChecked="{Binding S.AlertThreshold, Converter={StaticResource Equals}, ConverterParameter=85}" />
                                <RadioButton Style="{StaticResource Segment}" Content="90 °C" IsChecked="{Binding S.AlertThreshold, Converter={StaticResource Equals}, ConverterParameter=90}" />
                                <RadioButton Style="{StaticResource Segment}" Content="95 °C" IsChecked="{Binding S.AlertThreshold, Converter={StaticResource Equals}, ConverterParameter=95}" />
                            </StackPanel>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Alert threshold" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Temperature that triggers a notification." Style="{StaticResource RowDesc}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Behavior -->
            <TextBlock Text="Behavior" Style="{StaticResource T.Section}" />
            <Border Style="{StaticResource Card}" Padding="20,8">
                <StackPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding S.MinimizeToTray}" />
                        <StackPanel>
                            <TextBlock Text="Minimize to tray" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Hide the window in the notification area when minimized. Hover the tray icon for quick readings." Style="{StaticResource RowDesc}" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource Divider}" />
                    <DockPanel Style="{StaticResource Row}">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding StartWithWindows}" />
                        <StackPanel>
                            <TextBlock Text="Start with Windows" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Launch CPUx minimized when you sign in." Style="{StaticResource RowDesc}" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource Divider}" />
                    <DockPanel Style="{StaticResource Row}">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding S.StartMinimized}" />
                        <StackPanel>
                            <TextBlock Text="Start minimized" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Open in the background every time CPUx starts." Style="{StaticResource RowDesc}" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource Divider}" />
                    <DockPanel Style="{StaticResource Row}">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                  IsChecked="{Binding DataContext.IsTopmost, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <StackPanel>
                            <TextBlock Text="Always on top" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Keep the main window above other windows." Style="{StaticResource RowDesc}" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource Divider}" />
                    <DockPanel Style="{StaticResource Row}">
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding S.HardwareRendering}" />
                        <StackPanel>
                            <TextBlock Text="GPU-accelerated drawing" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Draw the interface on the graphics card. Uses about 150 MB more memory. Takes effect after restarting CPUx." Style="{StaticResource RowDesc}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Data -->
            <TextBlock Text="Reports" Style="{StaticResource T.Section}" />
            <Border Style="{StaticResource Card}" Padding="20,14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource Btn.Accent}" Content="HTML" Margin="8,0,0,0"
                                Command="{Binding DataContext.ExportCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="html" />
                        <Button Style="{StaticResource Btn}" Content="JSON" Margin="8,0,0,0"
                                Command="{Binding DataContext.ExportCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="json" />
                        <Button Style="{StaticResource Btn}" Content="Text" Margin="8,0,0,0"
                                Command="{Binding DataContext.ExportCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="txt" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Export system report" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="Everything CPUx knows about this PC, in one file you can share or archive." Style="{StaticResource RowDesc}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- About -->
            <TextBlock Text="About" Style="{StaticResource T.Section}" />
            <Border Style="{StaticResource Card}" Padding="20,16">
                <StackPanel>
                    <DockPanel>
                        <Border Width="44" Height="44" CornerRadius="12">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#3884FF" Offset="0" />
                                    <GradientStop Color="#8B5CF6" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <c:Icon Data="{StaticResource I.Cpu}" Width="24" Height="24" Foreground="White" StrokeThickness="2.2" />
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontSize="16" FontWeight="SemiBold">
                                <Run Text="CPUx " /><Run Text="{Binding Version, Mode=OneWay}" Foreground="{DynamicResource Text.Secondary}" FontWeight="Normal" />
                            </TextBlock>
                            <TextBlock Text="Hardware information and live system monitor" Style="{StaticResource T.Label}" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource Divider}" Margin="0,14" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Administrator rights" Style="{StaticResource T.Label}" Margin="0,4" />
                        <TextBlock Grid.Column="1" Margin="0,4">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="No — some sensors are limited" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAdmin}" Value="True">
                                            <Setter Property="Text" Value="Yes" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Grid.Row="1" Text="PawnIO sensor driver" Style="{StaticResource T.Label}" Margin="0,4" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Not installed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PawnIoInstalled}" Value="True">
                                                <Setter Property="Text" Value="Installed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button Style="{StaticResource Btn.Link}" Content="Get PawnIO" Command="{Binding OpenPawnIoCommand}" Margin="12,0,0,0"
                                    Visibility="{Binding PawnIoInstalled, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                        </StackPanel>
                        <TextBlock Grid.Row="2" Text="Settings &amp; logs" Style="{StaticResource T.Label}" Margin="0,4" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="{Binding DataFolder}" TextTrimming="CharacterEllipsis" />
                            <Button Style="{StaticResource Btn.Link}" Content="Open" Command="{Binding OpenDataFolderCommand}" Margin="12,0,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Row="3" Text="Sensor library" Style="{StaticResource T.Label}" Margin="0,4" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="LibreHardwareMonitor (MPL-2.0)" Margin="0,4" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
