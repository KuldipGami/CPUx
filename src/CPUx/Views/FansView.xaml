<UserControl x:Class="CPUx.Views.FansView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CPUx.Controls"
             xmlns:vm="clr-namespace:CPUx.ViewModels">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel>
            <!-- ======================= Overview ======================= -->
            <Border Style="{StaticResource Card}" Padding="22">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="{Binding HasControllable, Converter={StaticResource BoolToVis}}">
                            <Button Style="{StaticResource Btn}" Command="{Binding AllAutoCommand}" Content="All automatic" Margin="0,0,8,0" />
                            <Button Style="{StaticResource Btn}" Command="{Binding AllMaxCommand}" Content="All at full speed" />
                        </StackPanel>
                        <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}" Width="52" Height="52" CornerRadius="14" Background="{DynamicResource Accent.Soft}" Margin="0,0,16,0">
                            <c:Icon Data="{StaticResource I.Fan}" Width="26" Height="26" Foreground="{DynamicResource Accent}" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding HardwareText}" Style="{StaticResource T.CardTitle}" FontSize="16" />
                            <TextBlock Style="{StaticResource T.Label}" TextWrapping="Wrap" Margin="0,2,0,0"
                                       Text="Switch a fan to Manual and drag its slider to set a fixed speed. Automatic hands it back to the built-in fan curve." />
                        </StackPanel>
                    </DockPanel>

                    <WrapPanel Margin="0,16,0,0">
                        <StackPanel Margin="0,0,32,8" Visibility="{Binding IsAsus, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Performance mode" Style="{StaticResource T.Label}" Margin="0,0,0,6" />
                            <Border Style="{StaticResource SegmentHost}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" Content="Silent" IsChecked="{Binding AsusMode, Converter={StaticResource Equals}, ConverterParameter=2}" />
                                    <RadioButton Style="{StaticResource Segment}" Content="Performance" IsChecked="{Binding AsusMode, Converter={StaticResource Equals}, ConverterParameter=0}" />
                                    <RadioButton Style="{StaticResource Segment}" Content="Turbo" IsChecked="{Binding AsusMode, Converter={StaticResource Equals}, ConverterParameter=1}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Each mode has its own power limits and automatic fan curves." Style="{StaticResource T.Caption}" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8" Visibility="{Binding HasControllable, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Safety" Style="{StaticResource T.Label}" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding S.FanSafety}" />
                                <TextBlock Text="Return a slowed-down fan to automatic when the CPU reaches 95 °C or the GPU 85 °C"
                                           Style="{StaticResource T.Label}" TextWrapping="Wrap" MaxWidth="420" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </WrapPanel>

                    <Border Style="{StaticResource Chip}" Background="{DynamicResource Soft.Warn}" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                            Visibility="{Binding ArmouryCrateRunning, Converter={StaticResource BoolToVis}}">
                        <TextBlock FontSize="12" Foreground="{DynamicResource Warn}" TextWrapping="Wrap"
                                   Text="Armoury Crate is running. It can switch modes and fan curves on its own, for example when you plug in the charger. CPUx re-applies your fan speeds after power changes." />
                    </Border>
                    <StackPanel Visibility="{Binding HintText, Converter={StaticResource HasValue}}" Margin="0,8,0,0">
                        <TextBlock Text="{Binding HintText}" Style="{StaticResource T.Label}" TextWrapping="Wrap" />
                        <Button Style="{StaticResource Btn.Link}" Content="Get PawnIO" Command="{Binding OpenPawnIoCommand}" HorizontalAlignment="Left" Margin="0,6,0,0" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource T.Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,10,0,0"
                               Text="Manual speeds stay active while CPUx runs, including in the tray, and are undone when CPUx closes. A fan set too slow lets components run hotter; they protect themselves by slowing down." />
                </StackPanel>
            </Border>

            <!-- ======================= Fans ======================= -->
            <TextBlock Text="Fans" Style="{StaticResource T.Section}" Visibility="{Binding HasFans, Converter={StaticResource BoolToVis}}" />
            <ItemsControl ItemsSource="{Binding Fans}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <c:MasonryPanel MinColumnWidth="320" Spacing="16" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:FanItem}">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                                Visibility="{Binding CanControl, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Manual" Style="{StaticResource T.Label}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding IsManual}" />
                                    </StackPanel>
                                    <Border Style="{StaticResource IconTile}" Background="{DynamicResource Accent.Soft}">
                                        <c:Icon Data="{StaticResource I.Fan}" Foreground="{DynamicResource Accent}" Width="18" Height="18" />
                                    </Border>
                                    <StackPanel Margin="12,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource T.CardTitle}" />
                                        <TextBlock Text="{Binding Group}" Style="{StaticResource T.Caption}" />
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Text="{Binding RpmText}" Style="{StaticResource T.Big}" Margin="0,14,0,0" />
                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource T.Label}" Margin="0,1,0,0" />
                                <c:LiveChart Height="56" Margin="0,12,0,0" Series="{Binding RpmSeries}" Stroke="{DynamicResource Accent}"
                                             Maximum="0" MinimumScale="1000" ScaleUnit="RPM" />
                                <StackPanel Margin="0,14,0,0" Visibility="{Binding CanControl, Converter={StaticResource BoolToVis}}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding TargetText}" FontWeight="SemiBold" Width="44" TextAlignment="Right" VerticalAlignment="Center" />
                                        <Slider Style="{StaticResource Slider}" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10"
                                                Value="{Binding Target}" IsEnabled="{Binding IsManual}" Margin="0,0,10,0" />
                                    </DockPanel>
                                    <DockPanel Margin="0,2,54,0">
                                        <TextBlock DockPanel.Dock="Right" Text="100%" Style="{StaticResource T.Caption}" />
                                        <TextBlock Text="0%" Style="{StaticResource T.Caption}" />
                                    </DockPanel>
                                </StackPanel>
                                <TextBlock Text="{Binding Note}" Style="{StaticResource T.Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,10,0,0"
                                           Visibility="{Binding Note, Converter={StaticResource HasValue}}" />
                                <TextBlock Text="{Binding Error}" FontSize="12" Foreground="{DynamicResource Bad}" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Visibility="{Binding Error, Converter={StaticResource HasValue}}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ======================= Activity ======================= -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="{Binding Events.Count, Converter={StaticResource HasValue}}">
                <StackPanel>
                    <TextBlock Text="Activity" Style="{StaticResource T.CardTitle}" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Events}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource T.Label}" Margin="0,3" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
