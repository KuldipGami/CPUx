<UserControl x:Class="CPUx.Views.StressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CPUx.Controls"
             xmlns:vm="clr-namespace:CPUx.ViewModels"
             xmlns:svc="clr-namespace:CPUx.Services">
    <UserControl.Resources>
        <!-- Colored state chip: binds Text to a state string -->
        <Style x:Key="StateChip" TargetType="Border" BasedOn="{StaticResource Chip}">
            <Setter Property="Background" Value="{DynamicResource Bg.Subtle}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Running">
                    <Setter Property="Background" Value="{DynamicResource Accent.Soft}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Passed">
                    <Setter Property="Background" Value="{DynamicResource Soft.Good}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Failed">
                    <Setter Property="Background" Value="{DynamicResource Soft.Bad}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Errors">
                    <Setter Property="Background" Value="{DynamicResource Soft.Bad}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Stopped">
                    <Setter Property="Background" Value="{DynamicResource Soft.Warn}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StateText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="Running">
                    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="Passed">
                    <Setter Property="Foreground" Value="{DynamicResource Good}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="Failed">
                    <Setter Property="Foreground" Value="{DynamicResource Bad}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="Errors">
                    <Setter Property="Foreground" Value="{DynamicResource Bad}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="Stopped">
                    <Setter Property="Foreground" Value="{DynamicResource Warn}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OptLabel" TargetType="TextBlock" BasedOn="{StaticResource T.Label}">
            <Setter Property="Margin" Value="0,12,0,6" />
        </Style>

        <!-- Live score block shared by the component cards. DataContext = StressCard -->
        <DataTemplate x:Key="CardLive" DataType="{x:Type vm:StressCard}">
            <StackPanel Margin="0,14,0,0">
                <Border Height="1" Background="{DynamicResource Stroke.Divider}" Margin="0,0,0,12" />
                <DockPanel>
                    <Border DockPanel.Dock="Right" Style="{StaticResource StateChip}" Tag="{Binding State}">
                        <TextBlock Text="{Binding State}" Style="{StaticResource StateText}" />
                    </Border>
                    <TextBlock Text="{Binding Score}" Style="{StaticResource T.Stat}" FontSize="22" />
                </DockPanel>
                <TextBlock Text="{Binding Detail}" Style="{StaticResource T.Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,8" />
                <c:LiveChart Height="48" Series="{Binding ScoreSeries}" Stroke="{DynamicResource Accent}" Maximum="0" ShowGrid="False" StrokeThickness="1.4" />
                <Border Style="{StaticResource Chip}" Background="{DynamicResource Soft.Bad}" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                        Visibility="{Binding ErrorText, Converter={StaticResource HasValue}}">
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Bad}">
                        <Run Text="{Binding Errors, Mode=OneWay}" FontWeight="Bold" /><Run Text=" error(s): " /><Run Text="{Binding ErrorText, Mode=OneWay}" />
                    </TextBlock>
                </Border>
                <TextBlock Text="{Binding Average}" Style="{StaticResource T.Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,8,0,0"
                           Visibility="{Binding Average, Converter={StaticResource HasValue}}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel>
            <!-- ======================= Control panel ======================= -->
            <Border Style="{StaticResource Card}" Padding="22">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource Btn.Accent}" Command="{Binding StartCommand}" Padding="22,10" FontSize="14"
                                    Visibility="{Binding IsIdle, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <c:Icon Data="{StaticResource I.Play}" Width="15" Height="15" />
                                    <TextBlock Text="Start test" Margin="8,0,0,0" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Btn.Danger}" Command="{Binding StopCommand}" Padding="22,10" FontSize="14"
                                    IsEnabled="{Binding IsStopping, Converter={StaticResource Not}}"
                                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <c:Icon Data="{StaticResource I.Stop}" Width="15" Height="15" />
                                    <TextBlock Text="Stop" Margin="8,0,0,0" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}" Width="52" Height="52" CornerRadius="14" Background="{DynamicResource Soft.Temp}" Margin="0,0,16,0">
                            <c:Icon Data="{StaticResource I.Flame}" Width="26" Height="26" Foreground="{DynamicResource Brush.Temp}" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding TimeText}" Style="{StaticResource T.Big}" FontSize="28" />
                                <TextBlock Text="{Binding GoalText}" Style="{StaticResource T.Label}" FontSize="13" Margin="10,0,0,5" VerticalAlignment="Bottom" />
                                <Border Style="{StaticResource StateChip}" Tag="{Binding State}" Margin="14,0,0,0">
                                    <TextBlock Text="{Binding State}" Style="{StaticResource StateText}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource T.Label}" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <ProgressBar Style="{StaticResource Bar}" Value="{Binding Progress, Mode=OneWay}" Margin="0,16,0,0" Foreground="{DynamicResource Accent}"
                                 Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />

                    <WrapPanel Margin="0,10,0,0" IsEnabled="{Binding IsIdle}">
                        <StackPanel Margin="0,8,28,0">
                            <TextBlock Text="Duration" Style="{StaticResource T.Label}" Margin="0,0,0,6" />
                            <Border Style="{StaticResource SegmentHost}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" Content="1 min" IsChecked="{Binding DurationMin, Converter={StaticResource Equals}, ConverterParameter=1}" />
                                    <RadioButton Style="{StaticResource Segment}" Content="5 min" IsChecked="{Binding DurationMin, Converter={StaticResource Equals}, ConverterParameter=5}" />
                                    <RadioButton Style="{StaticResource Segment}" Content="10 min" IsChecked="{Binding DurationMin, Converter={StaticResource Equals}, ConverterParameter=10}" />
                                    <RadioButton Style="{StaticResource Segment}" Content="30 min" IsChecked="{Binding DurationMin, Converter={StaticResource Equals}, ConverterParameter=30}" />
                                    <RadioButton Style="{StaticResource Segment}" Content="1 h" IsChecked="{Binding DurationMin, Converter={StaticResource Equals}, ConverterParameter=60}" />
                                    <RadioButton Style="{StaticResource Segment}" Content="Until stopped" IsChecked="{Binding DurationMin, Converter={StaticResource Equals}, ConverterParameter=0}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Margin="0,8,28,0">
                            <TextBlock Text="Stop if CPU reaches" Style="{StaticResource T.Label}" Margin="0,0,0,6" />
                            <Border Style="{StaticResource SegmentHost}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" Content="85 °C" IsChecked="{Binding CpuTempLimit, Converter={StaticResource Equals}, ConverterParameter=85}" />
                                    <RadioButton Style="{StaticResource Segment}" Content="90 °C" IsChecked="{Binding CpuTempLimit, Converter={StaticResource Equals}, ConverterParameter=90}" />
                                    <RadioButton Style="{StaticResource Segment}" Content="95 °C" IsChecked="{Binding CpuTempLimit, Converter={StaticResource Equals}, ConverterParameter=95}" />
                                    <RadioButton Style="{StaticResource Segment}" Content="100 °C" IsChecked="{Binding CpuTempLimit, Converter={StaticResource Equals}, ConverterParameter=100}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Margin="0,8,28,0">
                            <TextBlock Text="Stop if GPU reaches" Style="{StaticResource T.Label}" Margin="0,0,0,6" />
                            <Border Style="{StaticResource SegmentHost}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" Content="80 °C" IsChecked="{Binding GpuTempLimit, Converter={StaticResource Equals}, ConverterParameter=80}" />
                                    <RadioButton Style="{StaticResource Segment}" Content="85 °C" IsChecked="{Binding GpuTempLimit, Converter={StaticResource Equals}, ConverterParameter=85}" />
                                    <RadioButton Style="{StaticResource Segment}" Content="87 °C" IsChecked="{Binding GpuTempLimit, Converter={StaticResource Equals}, ConverterParameter=87}" />
                                    <RadioButton Style="{StaticResource Segment}" Content="90 °C" IsChecked="{Binding GpuTempLimit, Converter={StaticResource Equals}, ConverterParameter=90}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Text="Stop on first error" Style="{StaticResource T.Label}" Margin="0,0,0,8" />
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding StopOnError}" HorizontalAlignment="Left" />
                        </StackPanel>
                    </WrapPanel>

                    <WrapPanel Margin="0,14,0,0">
                        <Border Style="{StaticResource Chip}" Background="{DynamicResource Soft.Warn}" Margin="0,0,8,6"
                                Visibility="{Binding OnBattery, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Running on battery — plug in for accurate results" FontSize="12" Foreground="{DynamicResource Warn}" />
                        </Border>
                        <Border Style="{StaticResource Chip}" Background="{DynamicResource Soft.Warn}" Margin="0,0,8,6"
                                Visibility="{Binding CpuTempMissing, Converter={StaticResource BoolToVis}}">
                            <TextBlock FontSize="12" Foreground="{DynamicResource Warn}"
                                       Text="CPU temperature unavailable, so the CPU safety stop can't trigger. Run as administrator with PawnIO installed to enable it." TextWrapping="Wrap" />
                        </Border>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource T.Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,0"
                               Text="Stress tests run components at full load: temperatures, fan noise and power draw will rise. Keep vents clear and stop the test if anything behaves unexpectedly." />
                </StackPanel>
            </Border>

            <!-- ======================= Components ======================= -->
            <TextBlock Text="Components" Style="{StaticResource T.Section}" />
            <c:MasonryPanel MinColumnWidth="360" Spacing="16">
                <!-- CPU -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Cpu.Enabled}" IsEnabled="{Binding IsIdle}" />
                            <Border Style="{StaticResource IconTile}" Background="{DynamicResource Soft.Cpu}">
                                <c:Icon Data="{StaticResource I.Cpu}" Foreground="{DynamicResource Brush.Cpu}" Width="18" Height="18" />
                            </Border>
                            <StackPanel Margin="12,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="Processor" Style="{StaticResource T.CardTitle}" />
                                <TextBlock Text="FP64 FMA/SIMD + integer math, results verified" Style="{StaticResource T.Caption}" />
                            </StackPanel>
                        </DockPanel>
                        <StackPanel IsEnabled="{Binding IsIdle}">
                            <TextBlock Text="Workload" Style="{StaticResource OptLabel}" />
                            <Border Style="{StaticResource SegmentHost}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" Content="Mixed" IsChecked="{Binding CpuMode, Converter={StaticResource Equals}, ConverterParameter=Mixed}" />
                                    <RadioButton Style="{StaticResource Segment}" Content="Floating point (hottest)" IsChecked="{Binding CpuMode, Converter={StaticResource Equals}, ConverterParameter=Fma}" />
                                    <RadioButton Style="{StaticResource Segment}" Content="Integer" IsChecked="{Binding CpuMode, Converter={StaticResource Equals}, ConverterParameter=Integer}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Threads" Style="{StaticResource OptLabel}" />
                            <Border Style="{StaticResource SegmentHost}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" Content="{Binding AllThreadsLabel}" IsChecked="{Binding CpuThreads, Converter={StaticResource Equals}, ConverterParameter=All}" />
                                    <RadioButton Style="{StaticResource Segment}" Content="{Binding PhysicalLabel}" IsChecked="{Binding CpuThreads, Converter={StaticResource Equals}, ConverterParameter=Physical}" />
                                    <RadioButton Style="{StaticResource Segment}" Content="Single" IsChecked="{Binding CpuThreads, Converter={StaticResource Equals}, ConverterParameter=Single}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <ContentControl Content="{Binding Cpu}" ContentTemplate="{StaticResource CardLive}" Focusable="False" />
                    </StackPanel>
                </Border>

                <!-- GPU -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Gpu.Enabled}" IsEnabled="{Binding IsIdle}" />
                            <Border Style="{StaticResource IconTile}" Background="{DynamicResource Soft.Gpu}">
                                <c:Icon Data="{StaticResource I.Gpu}" Foreground="{DynamicResource Brush.Gpu}" Width="18" Height="18" />
                            </Border>
                            <StackPanel Margin="12,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="Graphics" Style="{StaticResource T.CardTitle}" />
                                <TextBlock Text="Direct3D 11 compute load, results verified" Style="{StaticResource T.Caption}" />
                            </StackPanel>
                        </DockPanel>
                        <StackPanel IsEnabled="{Binding IsIdle}">
                            <TextBlock Text="Adapter" Style="{StaticResource OptLabel}" />
                            <ListBox ItemsSource="{Binding Gpus}" SelectedItem="{Binding SelectedGpu}" Style="{StaticResource PillList}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type svc:GpuInfo}">
                                        <TextBlock Text="{Binding ShortName}" FontSize="12.5" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <DockPanel Margin="0,4,0,0">
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding GpuMemory}" />
                                <StackPanel>
                                    <TextBlock Text="Also stress video memory" FontSize="13" />
                                    <TextBlock Text="Copies large buffers back and forth to load the memory controller" Style="{StaticResource T.Caption}" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                        <ContentControl Content="{Binding Gpu}" ContentTemplate="{StaticResource CardLive}" Focusable="False" />
                    </StackPanel>
                </Border>

                <!-- Memory -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Memory.Enabled}" IsEnabled="{Binding IsIdle}" />
                            <Border Style="{StaticResource IconTile}" Background="{DynamicResource Soft.Mem}">
                                <c:Icon Data="{StaticResource I.Memory}" Foreground="{DynamicResource Brush.Mem}" Width="18" Height="18" />
                            </Border>
                            <StackPanel Margin="12,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="Memory" Style="{StaticResource T.CardTitle}" />
                                <TextBlock Text="Write and verify test patterns across free RAM" Style="{StaticResource T.Caption}" />
                            </StackPanel>
                        </DockPanel>
                        <StackPanel IsEnabled="{Binding IsIdle}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding FreeMemoryText}" Style="{StaticResource T.Caption}" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                                <TextBlock Text="Amount of free memory to test" Style="{StaticResource OptLabel}" />
                            </DockPanel>
                            <Border Style="{StaticResource SegmentHost}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" Content="50%" IsChecked="{Binding MemPercent, Converter={StaticResource Equals}, ConverterParameter=50}" />
                                    <RadioButton Style="{StaticResource Segment}" Content="70%" IsChecked="{Binding MemPercent, Converter={StaticResource Equals}, ConverterParameter=70}" />
                                    <RadioButton Style="{StaticResource Segment}" Content="85%" IsChecked="{Binding MemPercent, Converter={StaticResource Equals}, ConverterParameter=85}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <ContentControl Content="{Binding Memory}" ContentTemplate="{StaticResource CardLive}" Focusable="False" />
                    </StackPanel>
                </Border>

                <!-- Disk -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Disk.Enabled}" IsEnabled="{Binding IsIdle}" />
                            <Border Style="{StaticResource IconTile}" Background="{DynamicResource Soft.Disk}">
                                <c:Icon Data="{StaticResource I.Storage}" Foreground="{DynamicResource Brush.Disk}" Width="18" Height="18" />
                            </Border>
                            <StackPanel Margin="12,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="Storage" Style="{StaticResource T.CardTitle}" />
                                <TextBlock Text="Sequential + random 4K I/O on a temporary file, data verified" Style="{StaticResource T.Caption}" />
                            </StackPanel>
                        </DockPanel>
                        <StackPanel IsEnabled="{Binding IsIdle}">
                            <TextBlock Text="Drive" Style="{StaticResource OptLabel}" />
                            <ListBox ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}" Style="{StaticResource PillList}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:DriveOption}">
                                        <TextBlock Text="{Binding Label}" FontSize="12.5" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="Test file size" Style="{StaticResource OptLabel}" Margin="0,4,0,6" />
                            <Border Style="{StaticResource SegmentHost}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" Content="1 GB" IsChecked="{Binding DiskGb, Converter={StaticResource Equals}, ConverterParameter=1}" />
                                    <RadioButton Style="{StaticResource Segment}" Content="4 GB" IsChecked="{Binding DiskGb, Converter={StaticResource Equals}, ConverterParameter=4}" />
                                    <RadioButton Style="{StaticResource Segment}" Content="8 GB" IsChecked="{Binding DiskGb, Converter={StaticResource Equals}, ConverterParameter=8}" />
                                    <RadioButton Style="{StaticResource Segment}" Content="16 GB" IsChecked="{Binding DiskGb, Converter={StaticResource Equals}, ConverterParameter=16}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource T.Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,8,0,0"
                                       Text="Each pass writes the whole file once plus random writes. The file is deleted when the test stops." />
                        </StackPanel>
                        <ContentControl Content="{Binding Disk}" ContentTemplate="{StaticResource CardLive}" Focusable="False" />
                    </StackPanel>
                </Border>
            </c:MasonryPanel>

            <!-- ======================= Live monitor ======================= -->
            <TextBlock Text="Live monitor" Style="{StaticResource T.Section}" />
            <c:MasonryPanel MinColumnWidth="420" Spacing="16">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Cpu}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding CpuTempText}" FontSize="12" Margin="0,0,12,0" />
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Gpu}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding GpuTempText}" FontSize="12" />
                            </StackPanel>
                            <TextBlock Text="Temperature" Style="{StaticResource T.CardTitle}" />
                        </DockPanel>
                        <Border BorderBrush="{DynamicResource Stroke.Divider}" BorderThickness="1" CornerRadius="8" Height="140">
                            <c:LiveChart Series="{Binding CpuTemp}" Series2="{Binding GpuTemp}" Stroke="{DynamicResource Brush.Cpu}" Stroke2="{DynamicResource Brush.Gpu}"
                                         Maximum="0" MinimumScale="90" ScaleUnit="C" CornerRadius="8" />
                        </Border>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Cpu}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding CpuUsageText}" FontSize="12" Margin="0,0,12,0" />
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Gpu}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding GpuUsageText}" FontSize="12" />
                            </StackPanel>
                            <TextBlock Text="Utilization" Style="{StaticResource T.CardTitle}" />
                        </DockPanel>
                        <Border BorderBrush="{DynamicResource Stroke.Divider}" BorderThickness="1" CornerRadius="8" Height="140">
                            <c:LiveChart Series="{Binding CpuUsage}" Series2="{Binding GpuUsage}" Stroke="{DynamicResource Brush.Cpu}" Stroke2="{DynamicResource Brush.Gpu}"
                                         Maximum="100" ScaleUnit="%" CornerRadius="8" />
                        </Border>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Cpu}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding CpuClockText}" FontSize="12" Margin="0,0,12,0" />
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Gpu}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding GpuClockText}" FontSize="12" />
                            </StackPanel>
                            <TextBlock Text="Clock speed" Style="{StaticResource T.CardTitle}" />
                        </DockPanel>
                        <Border BorderBrush="{DynamicResource Stroke.Divider}" BorderThickness="1" CornerRadius="8" Height="140">
                            <c:LiveChart Series="{Binding CpuClock}" Series2="{Binding GpuClock}" Stroke="{DynamicResource Brush.Cpu}" Stroke2="{DynamicResource Brush.Gpu}"
                                         Maximum="0" MinimumScale="1000" ScaleUnit="MHz" CornerRadius="8" />
                        </Border>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Cpu}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding CpuPowerText}" FontSize="12" Margin="0,0,12,0" />
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Gpu}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding GpuPowerText}" FontSize="12" />
                            </StackPanel>
                            <TextBlock Text="Power" Style="{StaticResource T.CardTitle}" />
                        </DockPanel>
                        <Border BorderBrush="{DynamicResource Stroke.Divider}" BorderThickness="1" CornerRadius="8" Height="140">
                            <c:LiveChart Series="{Binding CpuPower}" Series2="{Binding GpuPower}" Stroke="{DynamicResource Brush.Cpu}" Stroke2="{DynamicResource Brush.Gpu}"
                                         Maximum="0" MinimumScale="10" ScaleUnit="W" CornerRadius="8" />
                        </Border>
                    </StackPanel>
                </Border>
            </c:MasonryPanel>
            <StackPanel Orientation="Horizontal" Margin="2,8,0,0">
                <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Cpu}" Margin="0,0,5,0" VerticalAlignment="Center" />
                <TextBlock Text="CPU" Style="{StaticResource T.Caption}" Margin="0,0,14,0" />
                <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Gpu}" Margin="0,0,5,0" VerticalAlignment="Center" />
                <TextBlock Text="GPU (the adapter selected above)" Style="{StaticResource T.Caption}" />
            </StackPanel>

            <!-- ======================= Results + log ======================= -->
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Results" Style="{StaticResource T.Section}" />
                    <TextBlock Text="Results appear here when a test finishes." Style="{StaticResource T.Label}"
                               Visibility="{Binding Results.Count, Converter={StaticResource HasValue}, ConverterParameter=invert}" />
                    <ItemsControl ItemsSource="{Binding Results}" ItemTemplate="{StaticResource SectionCard}" Focusable="False">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Margin" Value="0,0,0,16" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Event log" Style="{StaticResource T.Section}" />
                    <Border Style="{StaticResource Card}" Padding="16,10">
                        <Grid>
                            <TextBlock Text="No events yet." Style="{StaticResource T.Label}" Margin="0,4"
                                       Visibility="{Binding Log.Count, Converter={StaticResource HasValue}, ConverterParameter=invert}" />
                            <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Log}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:StressLogEntry}">
                                            <Grid Margin="0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="64" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Time}" Style="{StaticResource T.Caption}" />
                                                <TextBlock x:Name="Msg" Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" FontSize="12.5" />
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="error">
                                                    <Setter TargetName="Msg" Property="Foreground" Value="{DynamicResource Bad}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
