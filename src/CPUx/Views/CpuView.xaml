<UserControl x:Class="CPUx.Views.CpuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CPUx.Controls"
             xmlns:core="clr-namespace:CPUx.Core"
             xmlns:vm="clr-namespace:CPUx.ViewModels">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel>
            <!-- Hero -->
            <Border Style="{StaticResource Card}" Padding="22">
                <DockPanel>
                    <Grid DockPanel.Dock="Right" Width="150" Height="150" Margin="24,0,0,0">
                        <c:RingGauge Value="{Binding Usage}" Stroke="{DynamicResource Brush.Cpu}" Thickness="12" />
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding UsageText}" Style="{StaticResource T.Big}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding SpeedText}" Style="{StaticResource T.Label}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource Chip}" Background="{DynamicResource Soft.Cpu}">
                                <TextBlock Text="{Binding Vendor}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource Brush.Cpu}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Font.Display}" FontSize="22" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Margin="0,10,0,14" />
                        <ItemsControl ItemsSource="{Binding Badges}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type core:InfoItem}">
                                    <Border Style="{StaticResource Inset}" Margin="0,0,8,8" Padding="12,7">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource T.Caption}" />
                                            <TextBlock Text="{Binding Value}" FontWeight="SemiBold" Margin="0,1,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Utilization -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding UsageText}" Style="{StaticResource T.CardTitle}" Foreground="{DynamicResource Brush.Cpu}" />
                        <TextBlock Text="Utilization" Style="{StaticResource T.CardTitle}" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Text="Overall utilization across all logical processors" Style="{StaticResource T.Caption}" Margin="0,8,0,0" />
                    <Border BorderBrush="{DynamicResource Stroke.Divider}" BorderThickness="1" CornerRadius="8" Height="220">
                        <c:LiveChart Series="{Binding UsageSeries}" Stroke="{DynamicResource Brush.Cpu}" Maximum="100" ShowDot="True"
                                     ScaleUnit="%" StrokeThickness="2" CornerRadius="8" />
                    </Border>
                </DockPanel>
            </Border>

            <!-- Live stats -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="18,16,18,4">
                <StackPanel>
                    <TextBlock Text="Live readings" Style="{StaticResource T.CardTitle}" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding Stats}" Style="{StaticResource StatGrid}" />
                </StackPanel>
            </Border>

            <!-- Logical processors -->
            <DockPanel Margin="0,0,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,12">
                    <Border Style="{StaticResource Chip}" Background="{DynamicResource Soft.Cpu}" Margin="0,0,6,0">
                        <TextBlock Text="P = performance core" FontSize="11.5" Foreground="{DynamicResource Brush.Cpu}" />
                    </Border>
                    <Border Style="{StaticResource Chip}" Background="{DynamicResource Soft.Gpu}">
                        <TextBlock Text="E = efficiency core" FontSize="11.5" Foreground="{DynamicResource Brush.Gpu}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="Logical processors" Style="{StaticResource T.Section}" />
            </DockPanel>
            <ItemsControl ItemsSource="{Binding Cores}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <c:MasonryPanel MinColumnWidth="148" Spacing="10" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:CoreTile}">
                        <Border Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Stroke.Card}" BorderThickness="1"
                                CornerRadius="10" Padding="11,9">
                            <StackPanel>
                                <DockPanel>
                                    <Border x:Name="KindBadge" DockPanel.Dock="Right" CornerRadius="4" Padding="5,0" Background="{DynamicResource Soft.Cpu}"
                                            Visibility="{Binding HasKind, Converter={StaticResource BoolToVis}}">
                                        <TextBlock x:Name="KindText" Text="{Binding Kind}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Cpu}" />
                                    </Border>
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource T.Caption}" />
                                </DockPanel>
                                <TextBlock Text="{Binding Usage}" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,4" />
                                <c:LiveChart x:Name="Chart" Height="34" Series="{Binding Series}" Stroke="{DynamicResource Brush.Cpu}" Maximum="100"
                                             ShowGrid="False" StrokeThickness="1.3" FillOpacity="0.28" />
                                <DockPanel Margin="0,5,0,0">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Temp}" Style="{StaticResource T.Caption}" />
                                    <TextBlock Text="{Binding Clock}" Style="{StaticResource T.Caption}" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="E">
                                <Setter TargetName="KindBadge" Property="Background" Value="{DynamicResource Soft.Gpu}" />
                                <Setter TargetName="KindText" Property="Foreground" Value="{DynamicResource Brush.Gpu}" />
                                <Setter TargetName="Chart" Property="Stroke" Value="{DynamicResource Brush.Gpu}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Instruction sets -->
            <TextBlock Text="Instruction sets" Style="{StaticResource T.Section}" />
            <Border Style="{StaticResource Card}" Padding="16,14,8,6">
                <ItemsControl ItemsSource="{Binding Features}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:FeatureChip}">
                            <Border x:Name="Chip" CornerRadius="6" Padding="9,4" Margin="0,0,8,8" Background="{DynamicResource Accent.Soft}">
                                <StackPanel Orientation="Horizontal">
                                    <c:Icon x:Name="Mark" Data="{StaticResource I.Check}" Width="12" Height="12" Foreground="{DynamicResource Accent}"
                                            StrokeThickness="2.6" Margin="0,0,5,0" />
                                    <TextBlock x:Name="Txt" Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Supported}" Value="False">
                                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Bg.Subtle}" />
                                    <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource Text.Tertiary}" />
                                    <Setter TargetName="Txt" Property="FontWeight" Value="Normal" />
                                    <Setter TargetName="Mark" Property="Data" Value="{StaticResource I.Close}" />
                                    <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource Text.Tertiary}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Details -->
            <TextBlock Text="Details" Style="{StaticResource T.Section}" />
            <ItemsControl ItemsSource="{Binding Sections}" Style="{StaticResource SectionList}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
