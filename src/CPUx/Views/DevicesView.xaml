<UserControl x:Class="CPUx.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CPUx.Controls"
             xmlns:vm="clr-namespace:CPUx.ViewModels">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="28,0,28,14">
            <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Command="{Binding LoadCommand}">
                <StackPanel Orientation="Horizontal">
                    <c:Icon Data="{StaticResource I.Refresh}" Width="14" Height="14" />
                    <TextBlock Text="Rescan" Margin="7,0,0,0" />
                </StackPanel>
            </Button>
            <TextBox Style="{StaticResource SearchBox}" Tag="Search devices, manufacturers or hardware IDs" MaxWidth="420" HorizontalAlignment="Left"
                     Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>

        <ScrollViewer Style="{StaticResource PageScroll}" Padding="28,0,22,28">
            <StackPanel>
                <TextBlock Text="Enumerating devices…" Style="{StaticResource T.Subtitle}" Margin="0,40" HorizontalAlignment="Center"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
                <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVis}}" />
                            <Setter Property="Margin" Value="0,0,0,10" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:DeviceGroup}">
                            <Expander Style="{StaticResource GroupExpander}" IsExpanded="{Binding IsExpanded}">
                                <Expander.Header>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Style="{StaticResource Chip}">
                                            <TextBlock Text="{Binding Count}" FontSize="11.5" Foreground="{DynamicResource Text.Secondary}" />
                                        </Border>
                                        <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Background="{DynamicResource Soft.Bad}" Margin="0,0,6,0"
                                                Visibility="{Binding HasProblems, Converter={StaticResource BoolToVis}}">
                                            <TextBlock FontSize="11.5" Foreground="{DynamicResource Bad}">
                                                <Run Text="{Binding Problems, Mode=OneWay}" /><Run Text=" problem(s)" />
                                            </TextBlock>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource T.CardTitle}" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Expander.Header>
                                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVis}}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:DeviceRow}">
                                            <Border BorderBrush="{DynamicResource Stroke.Divider}" BorderThickness="0,1,0,0" Padding="2,8" Background="Transparent"
                                                    ToolTip="{Binding Tooltip}">
                                                <Border.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Copy hardware ID" Command="{Binding CopyIdCommand}" />
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="220" />
                                                        <ColumnDefinition Width="130" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Manufacturer}" Style="{StaticResource T.Label}" Margin="0,0,12,0" />
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <Ellipse x:Name="Dot" Width="7" Height="7" Fill="{DynamicResource Good}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource T.Label}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding HasProblem}" Value="True">
                                                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Bad}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Disabled}" Value="True">
                                                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Text.Tertiary}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
