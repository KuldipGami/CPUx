<Window x:Class="CPUx.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:CPUx.Controls"
        xmlns:vm="clr-namespace:CPUx.ViewModels"
        xmlns:v="clr-namespace:CPUx.Views"
        Title="CPUx" Width="1320" Height="860" MinWidth="980" MinHeight="620"
        Icon="Assets/cpux.ico" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg.Base}" Foreground="{DynamicResource Text.Primary}"
        FontFamily="{StaticResource Font.Ui}" FontSize="13" UseLayoutRounding="True"
        Topmost="{Binding IsTopmost}">

    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+E" Command="{Binding ExportCommand}" CommandParameter="html" />
        <KeyBinding Gesture="Ctrl+P" Command="{Binding TogglePauseCommand}" />
        <KeyBinding Gesture="Ctrl+M" Command="{Binding OpenMiniCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><v:DashboardView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CpuViewModel}"><v:CpuView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:GpuViewModel}"><v:GpuView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:MemoryViewModel}"><v:MemoryView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:StorageViewModel}"><v:StorageView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:NetworkViewModel}"><v:NetworkView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:BoardViewModel}"><v:SectionsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SystemViewModel}"><v:SectionsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:BatteryViewModel}"><v:BatteryView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DisplayViewModel}"><v:DisplayView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SensorsViewModel}"><v:SensorsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProcessesViewModel}"><v:ProcessesView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DevicesViewModel}"><v:DevicesView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:StressViewModel}"><v:StressView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:FansViewModel}"><v:FansView /></DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================ Sidebar ============================ -->
        <DockPanel Margin="12,8,10,12">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,4,0,8">
                <Border Width="36" Height="36" CornerRadius="10">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#3884FF" Offset="0" />
                            <GradientStop Color="#8B5CF6" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <c:Icon Data="{StaticResource I.Cpu}" Width="20" Height="20" Foreground="White" StrokeThickness="2.2" />
                </Border>
                <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="CPUx" FontFamily="{StaticResource Font.Display}" FontSize="18" FontWeight="Bold" />
                    <TextBlock Text="Hardware monitor" Style="{StaticResource T.Caption}" />
                </StackPanel>
            </StackPanel>

            <Border DockPanel.Dock="Bottom" Style="{StaticResource Inset}" Margin="0,8,0,0" Padding="12,9">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" ToolTip="{Binding LastUpdate}">
                            <Ellipse x:Name="LiveDot" Width="7" Height="7" VerticalAlignment="Center" Fill="{DynamicResource Good}" />
                            <TextBlock Text="{Binding Status}" Margin="6,0,0,0" FontSize="12" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center" />
                        </StackPanel>
                        <c:Icon x:Name="AdminIcon" Data="{StaticResource I.Shield}" Width="16" Height="16" Foreground="{DynamicResource Text.Secondary}" />
                        <TextBlock Text="{Binding AdminText}" Margin="8,0,0,0" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <Button Style="{StaticResource Btn.Link}" Content="Restart as administrator" Command="{Binding RestartAsAdminCommand}"
                            Margin="24,3,0,0" HorizontalAlignment="Left"
                            Visibility="{Binding CanElevate, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>

            <ListBox Style="{StaticResource NavList}" ItemsSource="{Binding NavView}" SelectedItem="{Binding Selected}"
                     ItemContainerStyle="{StaticResource NavItem}">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource T.Caption}" FontWeight="SemiBold" Margin="12,10,0,4" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:NavItem}">
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Data="{Binding Icon, Converter={StaticResource IconKey}}" Width="18" Height="18" />
                            <TextBlock Text="{Binding Title}" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13.5" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- ============================ Content ============================ -->
        <Border Grid.Column="1" Background="{DynamicResource Bg.Layer}" BorderBrush="{DynamicResource Stroke.Card}"
                BorderThickness="1,1,0,0" CornerRadius="12,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Margin="28,22,28,14">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource Btn}" Command="{Binding TogglePauseCommand}" ToolTip="Pause or resume live updates (Ctrl+P)">
                            <StackPanel Orientation="Horizontal">
                                <c:Icon x:Name="PauseIcon" Data="{StaticResource I.Pause}" Width="15" Height="15" />
                                <TextBlock x:Name="PauseText" Text="Pause" Margin="7,0,0,0" />
                            </StackPanel>
                        </Button>
                        <ToggleButton Style="{StaticResource Btn}" IsChecked="{Binding IsTopmost}" Margin="8,0,0,0" Padding="9,7"
                                      ToolTip="Keep CPUx on top of other windows">
                            <c:Icon Data="{StaticResource I.Pin}" Width="15" Height="15" />
                        </ToggleButton>
                        <Button Style="{StaticResource Btn}" Command="{Binding OpenMiniCommand}" Margin="8,0,0,0" Padding="9,7"
                                ToolTip="Open the mini monitor overlay (Ctrl+M)">
                            <c:Icon Data="{StaticResource I.Pip}" Width="15" Height="15" />
                        </Button>
                        <Button x:Name="ExportButton" Style="{StaticResource Btn.Accent}" Margin="8,0,0,0" Click="Export_Click"
                                ToolTip="Export a full system report (Ctrl+E)">
                            <StackPanel Orientation="Horizontal">
                                <c:Icon Data="{StaticResource I.Export}" Width="15" Height="15" />
                                <TextBlock Text="Export" Margin="7,0,0,0" />
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="HTML report (.html)" Command="{Binding ExportCommand}" CommandParameter="html" />
                                    <MenuItem Header="JSON data (.json)" Command="{Binding ExportCommand}" CommandParameter="json" />
                                    <MenuItem Header="Plain text (.txt)" Command="{Binding ExportCommand}" CommandParameter="txt" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Current.Title}" Style="{StaticResource T.PageTitle}" />
                        <TextBlock Text="{Binding Current.Subtitle}" Style="{StaticResource T.Subtitle}" Margin="1,2,0,0" />
                    </StackPanel>
                </DockPanel>

                <ContentControl Grid.Row="1" Content="{Binding Current}" Focusable="False" />
            </Grid>
        </Border>
    </Grid>
</Window>
